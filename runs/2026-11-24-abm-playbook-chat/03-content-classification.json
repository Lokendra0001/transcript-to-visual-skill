  "classification": {
    "primary_type": "playbook",
    "secondary_types": [
      "process_flow",
      "taxonomy"
    ],
    "reasoning": "The deliverable is explicitly named a playbook and must explain an ordered path from identifying accounts to closed-won. A playbook holds the numbered step spine plus per-step option sets and rules. Process-flow treatment carries the explicit step order, downstream chain and CRM data-flow links; taxonomy treatment preserves the nested signal categories, demand-generation groups and awareness/tier lists. Workflow, funnel, decision tree and ecosystem map were rejected because they would invent operational logic, quantitative narrowing, branches, or detach tools from steps.",
    "supporting_refs": [
      "topic-001",
      "entity-001",
      "structure-001",
      "structure-003",
      "structure-004",
      "structure-007"
    ]
  },
  "candidate_evaluations": [
    {
      "id": "candidate-001",
      "type": "playbook",
      "outcome": "selected_primary",
      "assessment": "Best fit. The source itself names the deliverable a playbook and its objective is to explain how to go from identifying accounts to closing deals. A playbook carries both the numbered step spine and, per step, the optional tool sets, categories and rules — preserving alternatives as options rather than sequence.",
      "limitations": "Needs a supporting flow treatment to show the downstream chain and data-flow links clearly.",
      "supporting_refs": [
        "topic-001",
        "entity-001",
        "decision-001",
        "requirement-001"
      ]
    },
    {
      "id": "candidate-002",
      "type": "process_flow",
      "outcome": "selected_secondary",
      "assessment": "Supplies the explicit left-to-right order of the six steps plus the four downstream items, and the CRM 'informs/supports' links. Faithful to the corrected order (sequence enrollment before CRM tasks) and the single closed-won path.",
      "limitations": "On its own it would flatten tool options and the signal taxonomy into node labels, losing hierarchy; must not imply a closed-lost branch or step seven.",
      "supporting_refs": [
        "structure-001",
        "requirement-009",
        "requirement-010"
      ]
    },
    {
      "id": "candidate-003",
      "type": "taxonomy",
      "outcome": "selected_secondary",
      "assessment": "Required inside Step 3 (3 groups × 25 categories) and Step 6 (2 groups × 12 activities) and for the 5 awareness stages / 3 tiers. Preserves hierarchy and counts.",
      "limitations": "As a standalone visual it would lose the playbook sequence and the downstream outcome.",
      "supporting_refs": [
        "topic-005",
        "topic-011",
        "topic-009"
      ]
    },
    {
      "id": "candidate-004",
      "type": "workflow",
      "outcome": "rejected",
      "assessment": "Plausible because there is an ordered chain, but no actors, triggers, conditions or hand-offs are defined; framing as an operational workflow would imply detail the source does not supply.",
      "limitations": "Would invent operational logic (e.g. Slack trigger, stage owners).",
      "supporting_refs": [
        "ambiguity-005",
        "ambiguity-004"
      ]
    },
    {
      "id": "candidate-005",
      "type": "funnel",
      "outcome": "rejected",
      "assessment": "Awareness stages and identifying-to-closing suggest narrowing, but the source gives no volumes and explicitly refuses a stage-to-tier mapping; a funnel would imply quantitative narrowing and mapping.",
      "limitations": "Implies unsupported quantitative attrition and mapping.",
      "supporting_refs": [
        "fact-015",
        "decision-029",
        "requirement-007"
      ]
    },
    {
      "id": "candidate-006",
      "type": "ecosystem_map",
      "outcome": "rejected",
      "assessment": "Could show the ~27 tools/platforms, but would detach tools from the steps they serve and weaken the optional-per-step framing.",
      "limitations": "Loses the sequence, which is the primary objective.",
      "supporting_refs": [
        "structure-008"
      ]
    },
    {
      "id": "candidate-007",
      "type": "framework",
      "outcome": "rejected",
      "assessment": "A static framework grid could hold the six steps, but the source stresses an end-to-end path ending at closed-won; 'playbook' is the explicitly requested and more accurate type.",
      "limitations": "Under-represents the downstream sequence and outcome.",
      "supporting_refs": [
        "decision-001",
        "fact-002"
      ]
    },
    {
      "id": "candidate-008",
      "type": "decision_tree",
      "outcome": "rejected",
      "assessment": "No conditional branches exist; closed-lost branch is explicitly excluded.",
      "limitations": "Would invent branches.",
      "supporting_refs": [
        "decision-035",
        "requirement-010"
      ]
    },
